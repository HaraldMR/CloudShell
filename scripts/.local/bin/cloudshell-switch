#!/usr/bin/env bash
# Switch the running Quickshell config between cloudshell and ii (end-4).
#   cloudshell-switch cloudshell | ii | status
# Only touches ~/.config/hypr/custom/variables.lua (the qsConfig line), then restarts the shell.
set -euo pipefail

vars="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/custom/variables.lua"
current() {
    grep -oP 'hl\.env\("qsConfig",\s*"\K[^"]+' "$vars" 2>/dev/null || echo ii
}

target="${1:-status}"
case "$target" in
status)
    echo "Configured: $(current)"
    pgrep -ax qs || echo "No quickshell running"
    exit 0
    ;;
cloudshell | ii) ;;
*)
    echo "Usage: cloudshell-switch cloudshell | ii | status" >&2
    exit 1
    ;;
esac

[[ -d "${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/$target" ]] || {
    echo "No quickshell config named '$target'" >&2
    exit 1
}

mkdir -p "$(dirname "$vars")"
touch "$vars"
if grep -q 'hl.env("qsConfig"' "$vars"; then
    sed -i "s/hl\.env(\"qsConfig\",[^)]*)/hl.env(\"qsConfig\", \"$target\")/" "$vars"
else
    printf '\n-- Which Quickshell config to run (set by cloudshell-switch)\nhl.env("qsConfig", "%s")\n' "$target" >>"$vars"
fi

# Wallpaper: cloudshell uses skwd-wall's daemon, ii draws its own
if systemctl --user cat skwd-walld.service &>/dev/null; then
    if [[ "$target" == cloudshell ]]; then
        systemctl --user start skwd-walld.service || true
    else
        systemctl --user stop skwd-walld.service || true
    fi
fi

pkill -x qs || true
pkill -x quickshell || true
sleep 0.5
hyprctl reload >/dev/null 2>&1 || true
setsid qs -c "$target" -d >/dev/null 2>&1 </dev/null &
echo "Switched to $target"
